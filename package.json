{
  "name": "psy-anthem",
  "version": "0.1.0",
  "description": "PSY ANTHEM - Melodic composition engine for the PSY family. Pure WHAT layer. Constraint-based. Deterministic. Anthem-grade.",
  "type": "module",
  "main": "dist/psy-anthem.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/psy-anthem.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun test tests/integration/",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts",
    "bench": "bun run scripts/benchmark.ts",
    "pianoroll": "bun run scripts/render-piano-roll.ts",
    "cli": "bun run scripts/cli.ts",
    "example": "bun run examples/01-basic-generation.ts",
    "bundle": "bun build src/index.ts --target browser --format esm --minify --outfile dist/psy-anthem.mjs",
    "lint": "bun run scripts/validate.ts"
  },
  "keywords": ["psytrance","composition","melody","anthem","generative","deterministic","constraint-satisfaction"],
  "author": "dudududi144-source",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.5.0"
  },
  "engines": { "bun": ">=1.1.0" }
}
